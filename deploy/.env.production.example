# Compose database initialization. Keep these values consistent with DATABASE_URL.
POSTGRES_DB=vietnam_travel_advisor
POSTGRES_USER=vta
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The backend uses Docker service names, never localhost, inside Compose.
DATABASE_URL=postgresql+asyncpg://vta:replace-with-a-long-random-password@postgres:5432/vietnam_travel_advisor
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=travel_chunks

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
CORS_ORIGINS=

# Caddy obtains and renews the public TLS certificate automatically.
APP_DOMAIN=travel.example.com
ACME_EMAIL=operator@example.com

# Public origin for password recovery links. Never use an internal Docker URL.
PUBLIC_APP_URL=https://travel.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PASSWORD_RESET_EXPIRE_MINUTES=20

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=replace-with-tavily-api-key
OPENWEATHER_API_KEY=replace-with-openweather-api-key
GOONG_API_KEY=replace-with-goong-api-key

REDIS_ENABLED=true
RATE_LIMIT_ENABLED=true
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Model settings are explicit so operators know what is cached in the volume.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=10
RAG_RERANKER_CPU_INT8=true
RAG_RERANKER_BATCH_SIZE=8
RAG_RERANKER_MAX_LENGTH=512
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
