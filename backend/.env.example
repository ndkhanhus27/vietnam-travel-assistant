DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vietnam_travel
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Use the same OAuth 2.0 Web Client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PASSWORD_RESET_EXPIRE_MINUTES=20

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_WEATHER_TTL_SECONDS=1800
CACHE_GEOCODE_TTL_SECONDS=86400
CACHE_CONTEXT_TTL_SECONDS=1800

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=travel_chunks

# Hybrid + Reranker preset from the 2026-10-11 retrieval evaluation.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_DENSE_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_HYBRID_LIMIT=12
RAG_RRF_K=60
RAG_RRF_DENSE_WEIGHT=1.0
RAG_RRF_BM25_WEIGHT=1.0
RAG_RRF_ENTITY_WEIGHT=0.5
RAG_RERANK_ENABLED=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_RERANKER_CPU_INT8=true
RAG_RERANK_CANDIDATES=10
RAG_RERANK_LIMIT=6
RAG_RERANKER_BATCH_SIZE=8
RAG_RERANKER_MAX_LENGTH=512

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
GOONG_API_KEY=
