DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vietnam_travel
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Use the same OAuth 2.0 Web Client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
