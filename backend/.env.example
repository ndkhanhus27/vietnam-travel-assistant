DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vietnam_travel
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Use the same OAuth 2.0 Web Client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PASSWORD_RESET_EXPIRE_MINUTES=20

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=travel_chunks

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
GOONG_API_KEY=
